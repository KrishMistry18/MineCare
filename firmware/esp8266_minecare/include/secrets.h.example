#ifndef MINECARE_SECRETS_H_EXAMPLE
#define MINECARE_SECRETS_H_EXAMPLE

/**
 * MineCare ESP8266 Firmware - Secrets Configuration Template
 *
 * INSTRUCTIONS:
 * 1. Copy this file to 'secrets.h' in the same directory:
 *    cp include/secrets.h.example include/secrets.h
 * 2. Fill in your real Wi-Fi SSID, Wi-Fi password, backend URL, and device token.
 * 3. 'secrets.h' is explicitly ignored by .gitignore and MUST NEVER BE COMMITTED.
 * 4. NEVER hard-code credentials directly in source files or log them over Serial.
 */

// =============================================================================
// WI-FI CREDENTIALS
// =============================================================================
#define MINECARE_WIFI_SSID       "YOUR_MINE_WIFI_SSID"
#define MINECARE_WIFI_PASSWORD   "YOUR_WIFI_PRESHARED_KEY"

// =============================================================================
// BACKEND CONFIGURATION
// =============================================================================
// Use HTTPS in production (e.g. "https://minecare-backend.onrender.com")
// Or local staging server IP (e.g. "http://192.168.1.100:3000")
#define MINECARE_BACKEND_URL     "https://minecare-backend.onrender.com"

// Helmet identifier bound to this physical unit in the MineCare database
#define MINECARE_HELMET_ID       "MC-001"

// High-entropy 256-bit device token provisioned via:
// POST /api/v1/admin/helmets/:id/device-token
// Format: mc_live_<helmetId>_<64hexCharacters> (Production)
// Or:     mc_dev_<helmetId>                   (Local Dev/Staging Only)
#define MINECARE_DEVICE_TOKEN    "mc_live_MC-001_REPLACE_WITH_PROVISIONED_64_HEX_TOKEN"

#endif // MINECARE_SECRETS_H_EXAMPLE
