# ====================================================================
# MineCare Environment Variables Template
# ====================================================================
# Copy this file to .env for local overrides or configure these variables
# directly in your cloud hosting provider dashboard (Vercel / Render).
#
# When omitted, MineCare runs in local embedded mode with 100% functionality
# using an authoritative in-memory relational repository.
# ====================================================================

# --------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vercel)
# --------------------------------------------------------------------
# Base URL of the backend API (e.g., https://minecare-api.onrender.com).
# Leave blank for local development to use the Vite dev proxy.
VITE_API_URL=

# Remote Supabase project URL (e.g., https://<project-id>.supabase.co).
# Optional: if omitted, real-time defaults to the backend SSE stream.
VITE_SUPABASE_URL=

# Remote Supabase public anonymous API key (safe for browser exposure).
VITE_SUPABASE_ANON_KEY=

# --------------------------------------------------------------------
# 2. BACKEND CONFIGURATION (Render Web Service)
# --------------------------------------------------------------------
# Host interface to bind to (0.0.0.0 is required for Render/Docker).
HOST=0.0.0.0

# HTTP port to listen on (Render supplies PORT dynamically; default: 3001).
PORT=3001

# Application environment mode ('development' or 'production').
NODE_ENV=production

# Permitted frontend origin for Cross-Origin Resource Sharing (CORS).
# e.g., https://minecare.vercel.app (supports comma-separated list).
# Leave unset in local development for safe fallback.
CORS_ORIGIN=

# --------------------------------------------------------------------
# 3. SUPABASE SERVICE ROLE (SERVER-SIDE ONLY - CRITICAL SECURITY)
# --------------------------------------------------------------------
# WARNING:
# - SERVER ONLY
# - NEVER expose to VITE_ variables or browser client code
# - NEVER commit the actual secret value to version control
SUPABASE_SERVICE_ROLE_KEY=
