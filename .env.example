# ====================================================================
# MineCare Environment Variables Specification (Phase 8 Production Ready)
# ====================================================================
# Copy this file to .env for local overrides, or configure these variables
# directly in your cloud hosting provider dashboard (Render / Vercel).
#
# CRITICAL SECURITY RULES:
# 1. Variables prefixed with 'VITE_' are bundled into client code and publicly visible.
# 2. Variables WITHOUT 'VITE_' are strictly server-side and MUST NOT be exposed.
# 3. NEVER prefix backend-only secrets (DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY) with VITE_.
# ====================================================================

# --------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vercel / Browser)
# --------------------------------------------------------------------
# Base URL of the backend API (e.g., https://minecare-api.onrender.com).
# Leave blank for local development to use the Vite dev proxy.
VITE_API_URL=

# Remote Supabase project URL (e.g., https://<project-ref>.supabase.co).
# Used by frontend client for authentication and optional real-time channels.
VITE_SUPABASE_URL=

# Remote Supabase public anonymous/publishable API key (safe for browser exposure).
# Do NOT confuse with SUPABASE_SERVICE_ROLE_KEY!
VITE_SUPABASE_ANON_KEY=

# --------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (Render Web Service / Node.js)
# --------------------------------------------------------------------
# Application environment mode ('development', 'production', or 'test').
# In 'production' mode, valid PostgreSQL credentials are strictly required.
NODE_ENV=production

# HTTP port to listen on (Render supplies PORT dynamically; default: 3001).
PORT=3001

# Host network interface to bind to (0.0.0.0 is required for containerized environments).
HOST=0.0.0.0

# Permitted frontend origin for Cross-Origin Resource Sharing (CORS).
# e.g., https://minecare.vercel.app (supports comma-separated list for multiple origins).
# Leave unset in local development for safe localhost fallback.
CORS_ORIGIN=

# --------------------------------------------------------------------
# 3. PRODUCTION DATABASE CONFIGURATION (PostgreSQL / Supabase)
# --------------------------------------------------------------------
# PostgreSQL Connection URI (Supabase Transaction Pooler or Direct Connection)
# Format: postgresql://postgres:[PASSWORD]@db.<project-ref>.supabase.co:5432/postgres
# Or Transaction Pooler: postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Supabase Project REST Endpoint (Server-Side)
# e.g., https://<project-ref>.supabase.co
SUPABASE_URL=

# Supabase Service Role Key (SERVER-SIDE ONLY - CRITICAL SECURITY)
# WARNING:
# - Full administrative bypass of Row Level Security (RLS).
# - NEVER expose to browser clients or prefix with VITE_.
# - NEVER commit real credentials to version control.
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------------
# 4. PRODUCTION AUTHENTICATION & JWT VERIFICATION
# --------------------------------------------------------------------
# Supabase JWT Issuer URI (for verifying signature of Supabase Auth tokens).
# Default: https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=

# Supabase JWKS (JSON Web Key Set) URL for public key rotation / asymmetric token verification.
# Default: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Supabase JWT Secret (Optional: for symmetric HMAC-SHA256 signature verification)
SUPABASE_JWT_SECRET=

# --------------------------------------------------------------------
# 5. HARDWARE IOT & DEVICE AUTHENTICATION BOUNDARY
# --------------------------------------------------------------------
# Shared hardware gateway secret (X-Device-Token) for microcontrollers / telemetry forwarder.
# Individual helmets use format: mc_dev_<helmetId> (e.g., mc_dev_MC-001) or registered tokens.
MINECARE_DEVICE_SECRET=

# Comma-separated list of explicitly revoked device tokens
MINECARE_REVOKED_DEVICE_TOKENS=

